<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TypingSpeed Pro - 打字速度测试</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: 'Segoe UI', 'Microsoft YaHei', sans-serif;
            background: linear-gradient(135deg, #0f0c29, #302b63, #24243e);
            min-height: 100vh;
            color: #e0e0e0;
            overflow-x: hidden;
        }

        /* 粒子背景 */
        .particles {
            position: fixed;
            top: 0; left: 0;
            width: 100%; height: 100%;
            pointer-events: none;
            z-index: 0;
        }
        .particle {
            position: absolute;
            width: 3px; height: 3px;
            background: rgba(255,255,255,0.3);
            border-radius: 50%;
            animation: float linear infinite;
        }
        @keyframes float {
            0% { transform: translateY(100vh) rotate(0deg); opacity: 0; }
            10% { opacity: 1; }
            90% { opacity: 1; }
            100% { transform: translateY(-10vh) rotate(720deg); opacity: 0; }
        }

        /* 导航 */
        header {
            background: rgba(255,255,255,0.05);
            backdrop-filter: blur(15px);
            border-bottom: 1px solid rgba(255,255,255,0.1);
            padding: 18px 40px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: relative;
            z-index: 10;
        }
        header .logo { font-size: 24px; font-weight: bold; }
        header .logo span { color: #00e5ff; }
        header .mode-switch { display: flex; gap: 10px; }
        header .mode-btn {
            padding: 8px 18px;
            border: 1px solid rgba(255,255,255,0.2);
            background: transparent;
            color: white;
            border-radius: 20px;
            cursor: pointer;
            transition: 0.3s;
            font-size: 14px;
        }
        header .mode-btn.active, header .mode-btn:hover {
            background: #00e5ff;
            color: #0f0c29;
            border-color: #00e5ff;
            font-weight: bold;
        }

        .container { max-width: 900px; margin: 0 auto; padding: 40px 20px; position: relative; z-index: 10; }

        /* 状态栏 */
        .status-bar {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 15px;
            margin-bottom: 35px;
        }
        .status-item {
            background: rgba(255,255,255,0.06);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 16px;
            padding: 20px;
            text-align: center;
            transition: 0.3s;
        }
        .status-item:hover { border-color: #00e5ff; box-shadow: 0 0 20px rgba(0,229,255,0.1); }
        .status-item .value {
            font-size: 36px;
            font-weight: bold;
            background: linear-gradient(135deg, #00e5ff, #651fff);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .status-item .label { font-size: 13px; color: #999; margin-top: 5px; }

        /* 计时条 */
        .timer-bar {
            width: 100%;
            height: 6px;
            background: rgba(255,255,255,0.1);
            border-radius: 10px;
            margin-bottom: 30px;
            overflow: hidden;
        }
        .timer-fill {
            height: 100%;
            background: linear-gradient(90deg, #00e5ff, #651fff);
            border-radius: 10px;
            transition: width 1s linear;
            width: 100%;
        }

        /* 打字区域 */
        .typing-area {
            background: rgba(255,255,255,0.04);
            backdrop-filter: blur(15px);
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 20px;
            padding: 40px;
            margin-bottom: 30px;
            position: relative;
        }
        .typing-area .prompt-label {
            font-size: 13px;
            color: #00e5ff;
            text-transform: uppercase;
            letter-spacing: 2px;
            margin-bottom: 20px;
        }
        .text-display {
            font-size: 22px;
            line-height: 2;
            letter-spacing: 1px;
            min-height: 120px;
            word-wrap: break-word;
        }
        .text-display .char { transition: color 0.1s; }
        .text-display .char.correct { color: #00e676; }
        .text-display .char.incorrect { color: #ff1744; background: rgba(255,23,68,0.2); border-radius: 3px; }
        .text-display .char.current {
            border-bottom: 2px solid #00e5ff;
            color: #fff;
            animation: blink 1s infinite;
        }
        .text-display .char.waiting { color: #555; }

        @keyframes blink {
            0%, 100% { border-bottom-color: #00e5ff; }
            50% { border-bottom-color: transparent; }
        }

        .hidden-input {
            position: absolute;
            opacity: 0;
            top: 0; left: 0;
            width: 100%; height: 100%;
            cursor: text;
        }

        /* 开始提示 */
        .start-overlay {
            position: absolute;
            top: 0; left: 0;
            width: 100%; height: 100%;
            background: rgba(15,12,41,0.85);
            backdrop-filter: blur(5px);
            border-radius: 20px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            z-index: 5;
            cursor: pointer;
        }
        .start-overlay .icon { font-size: 48px; margin-bottom: 15px; }
        .start-overlay .text { font-size: 18px; color: #aaa; }

        /* 按钮 */
        .btn-group { display: flex; gap: 15px; justify-content: center; margin-bottom: 40px; }
        .btn {
            padding: 14px 36px;
            border: none;
            border-radius: 50px;
            font-size: 16px;
            cursor: pointer;
            transition: 0.3s;
            font-weight: bold;
        }
        .btn-primary {
            background: linear-gradient(135deg, #00e5ff, #651fff);
            color: white;
        }
        .btn-primary:hover { transform: translateY(-3px); box-shadow: 0 10px 30px rgba(0,229,255,0.3); }
        .btn-secondary {
            background: rgba(255,255,255,0.08);
            color: white;
            border: 1px solid rgba(255,255,255,0.2);
        }
        .btn-secondary:hover { background: rgba(255,255,255,0.15); }

        /* 历史记录 */
        .history {
            background: rgba(255,255,255,0.04);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 20px;
            padding: 30px;
        }
        .history h3 {
            font-size: 20px;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .history h3 span { color: #00e5ff; }
        .history-list { display: flex; flex-direction: column; gap: 10px; }
        .history-item {
            display: grid;
            grid-template-columns: 40px 1fr 80px 80px 80px;
            align-items: center;
            padding: 12px 18px;
            background: rgba(255,255,255,0.03);
            border-radius: 12px;
            font-size: 14px;
            gap: 10px;
        }
        .history-item .rank {
            width: 30px; height: 30px;
            background: linear-gradient(135deg, #00e5ff, #651fff);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            font-size: 13px;
            color: white;
        }
        .history-item .mode-tag {
            padding: 3px 10px;
            background: rgba(0,229,255,0.15);
            color: #00e5ff;
            border-radius: 10px;
            font-size: 12px;
            display: inline-block;
        }
        .history-item .wpm { color: #00e5ff; font-weight: bold; }
        .history-item .acc { color: #00e676; }
        .history-item .time { color: #999; }

        .empty-state { text-align: center; color: #555; padding: 30px; font-size: 15px; }

        /* 结果弹窗 */
        .result-modal {
            display: none;
            position: fixed;
            top: 0; left: 0;
            width: 100%; height: 100%;
            background: rgba(0,0,0,0.7);
            backdrop-filter: blur(10px);
            z-index: 100;
            align-items: center;
            justify-content: center;
        }
        .result-modal.show { display: flex; }
        .result-card {
            background: linear-gradient(135deg, #1a1a2e, #16213e);
            border: 1px solid rgba(255,255,255,0.15);
            border-radius: 24px;
            padding: 50px;
            text-align: center;
            max-width: 500px;
            width: 90%;
            animation: popIn 0.3s ease;
        }
        @keyframes popIn {
            0% { transform: scale(0.8); opacity: 0; }
            100% { transform: scale(1); opacity: 1; }
        }
        .result-card .emoji { font-size: 64px; margin-bottom: 15px; }
        .result-card h2 { font-size: 28px; margin-bottom: 25px; }
        .result-stats { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 30px; }
        .result-stat {
            background: rgba(255,255,255,0.05);
            padding: 20px;
            border-radius: 16px;
        }
        .result-stat .val {
            font-size: 32px;
            font-weight: bold;
            background: linear-gradient(135deg, #00e5ff, #651fff);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .result-stat .lbl { font-size: 13px; color: #888; margin-top: 5px; }

        /* 键盘热力图 */
        .keyboard {
            margin-top: 30px;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 6px;
        }
        .kb-row { display: flex; gap: 5px; }
        .key {
            min-width: 38px;
            height: 38px;
            background: rgba(255,255,255,0.06);
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 13px;
            color: #888;
            transition: 0.2s;
        }
        .key.hot-1 { background: rgba(0,229,255,0.15); color: #00e5ff; border-color: rgba(0,229,255,0.3); }
        .key.hot-2 { background: rgba(0,229,255,0.3); color: #00e5ff; border-color: rgba(0,229,255,0.5); }
        .key.hot-3 { background: rgba(0,229,255,0.5); color: white; border-color: #00e5ff; }
        .key.error { background: rgba(255,23,68,0.3); color: #ff1744; border-color: rgba(255,23,68,0.5); }
        .key.space { min-width: 220px; }

        @media (max-width: 768px) {
            .status-bar { grid-template-columns: repeat(2, 1fr); }
            .typing-area { padding: 25px; }
            .text-display { font-size: 18px; }
            .history-item { grid-template-columns: 30px 1fr 60px 60px; }
            .result-stats { grid-template-columns: 1fr; }
            .keyboard { display: none; }
        }
    </style>
</head>
<body>
    <!-- 粒子 -->
    <div class="particles" id="particles"></div>

    <header>
        <div class="logo">Typing<span>Speed</span> Pro ⌨️</div>
        <div class="mode-switch">
            <button class="mode-btn active" onclick="setDuration(30)">30秒</button>
            <button class="mode-btn" onclick="setDuration(60)">60秒</button>
            <button class="mode-btn" onclick="setDuration(120)">120秒</button>
        </div>
    </header>

    <div class="container">
        <!-- 状态栏 -->
        <div class="status-bar">
            <div class="status-item">
                <div class="value" id="wpmDisplay">0</div>
                <div class="label">WPM (词/分)</div>
            </div>
            <div class="status-item">
                <div class="value" id="accDisplay">100%</div>
                <div class="label">正确率</div>
            </div>
            <div class="status-item">
                <div class="value" id="timeDisplay">30</div>
                <div class="label">剩余时间(秒)</div>
            </div>
            <div class="status-item">
                <div class="value" id="charDisplay">0</div>
                <div class="label">已输入字符</div>
            </div>
        </div>

        <!-- 计时条 -->
        <div class="timer-bar">
            <div class="timer-fill" id="timerFill"></div>
        </div>

        <!-- 打字区域 -->
        <div class="typing-area" id="typingArea">
            <div class="prompt-label">📝 测试文本</div>
            <div class="text-display" id="textDisplay"></div>
            <input type="text" class="hidden-input" id="hiddenInput" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false">
            <div class="start-overlay" id="startOverlay" onclick="startTest()">
                <div class="icon">⌨️</div>
                <div class="text">点击此处开始打字测试</div>
            </div>
        </div>

        <!-- 按钮 -->
        <div class="btn-group">
            <button class="btn btn-primary" onclick="resetTest()">🔄 重新开始</button>
            <button class="btn btn-secondary" onclick="changeText()">📝 换一段文字</button>
        </div>

        <!-- 键盘热力图 -->
        <div class="keyboard" id="keyboard">
            <div class="kb-row" id="kbRow1"></div>
            <div class="kb-row" id="kbRow2"></div>
            <div class="kb-row" id="kbRow3"></div>
            <div class="kb-row" id="kbRow4"></div>
        </div>

        <!-- 历史记录 -->
        <div class="history">
            <h3>📊 <span>历史记录</span></h3>
            <div class="history-list" id="historyList">
                <div class="empty-state">暂无记录，完成一次测试后显示</div>
            </div>
        </div>
    </div>

    <!-- 结果弹窗 -->
    <div class="result-modal" id="resultModal">
        <div class="result-card">
            <div class="emoji" id="resultEmoji">🎉</div>
            <h2 id="resultTitle">测试完成！</h2>
            <div class="result-stats">
                <div class="result-stat">
                    <div class="val" id="resultWpm">0</div>
                    <div class="lbl">WPM (词/分钟)</div>
                </div>
                <div class="result-stat">
                    <div class="val" id="resultAcc">0%</div>
                    <div class="lbl">正确率</div>
                </div>
                <div class="result-stat">
                    <div class="val" id="resultChars">0</div>
                    <div class="lbl">总输入字符</div>
                </div>
                <div class="result-stat">
                    <div class="val" id="resultErrors">0</div>
                    <div class="lbl">错误数</div>
                </div>
            </div>
            <button class="btn btn-primary" onclick="closeResult()">👍 再来一次</button>
        </div>
    </div>

    <script>
        // ========== 语料库 ==========
        const texts = [
            "The quick brown fox jumps over the lazy dog. Programming is the art of telling another human being what one wants the computer to do. Technology is best when it brings people together.",
            "Success is not final, failure is not fatal. It is the courage to continue that counts. The only way to do great work is to love what you do. Innovation distinguishes between a leader and a follower.",
            "In the middle of difficulty lies opportunity. The greatest glory in living lies not in never falling, but in rising every time we fall. Life is what happens when you are busy making other plans.",
            "Artificial intelligence is the new electricity. Machine learning is a subset of AI that enables systems to learn from data. Deep learning uses neural networks with many layers to model complex patterns.",
            "The best time to plant a tree was twenty years ago. The second best time is now. Education is the most powerful weapon which you can use to change the world. Knowledge is power.",
            "Climate change is one of the most pressing challenges of our time. Rising global temperatures are causing sea levels to rise and weather patterns to shift dramatically across the planet.",
            "Space exploration represents humanity's greatest adventure. From the first moon landing to modern Mars rovers, we continue to push the boundaries of what is possible in the cosmos.",
            "The internet has transformed how we communicate, work, and live. Social media connects billions of people worldwide, creating new opportunities for collaboration and cultural exchange."
        ];

        // ========== 键盘布局 ==========
        const kbRows = [
            ['Q','W','E','R','T','Y','U','I','O','P'],
            ['A','S','D','F','G','H','J','K','L'],
            ['Z','X','C','V','B','N','M'],
            ['SPACE']
        ];

        // ========== 状态变量 ==========
        let currentText = '';
        let charIndex = 0;
        let errors = 0;
        let correctChars = 0;
        let totalTyped = 0;
        let isStarted = false;
        let isFinished = false;
        let timer = null;
        let duration = 30;
        let timeLeft = 30;
        let keyHeatMap = {};
        let keyErrorMap = {};
        let history = JSON.parse(localStorage.getItem('typingHistory') || '[]');

        // ========== 初始化 ==========
        function init() {
            createParticles();
            renderKeyboard();
            changeText();
            renderHistory();
        }

        function createParticles() {
            const container = document.getElementById('particles');
            for (let i = 0; i < 30; i++) {
                const p = document.createElement('div');
                p.className = 'particle';
                p.style.left = Math.random() * 100 + '%';
                p.style.animationDuration = (Math.random() * 10 + 8) + 's';
                p.style.animationDelay = Math.random() * 10 + 's';
                p.style.width = p.style.height = (Math.random() * 3 + 1) + 'px';
                container.appendChild(p);
            }
        }

        function renderKeyboard() {
            kbRows.forEach((row, idx) => {
                const rowEl = document.getElementById('kbRow' + (idx + 1));
                row.forEach(key => {
                    const k = document.createElement('div');
                    k.className = 'key' + (key === 'SPACE' ? ' space' : '');
                    k.textContent = key === 'SPACE' ? '—— SPACE ——' : key;
                    k.id = 'key-' + key;
                    rowEl.appendChild(k);
                });
            });
        }

        // ========== 文本渲染 ==========
        function changeText() {
            currentText = texts[Math.floor(Math.random() * texts.length)];
            renderText();
            resetTest();
        }

        function renderText() {
            const display = document.getElementById('textDisplay');
            display.innerHTML = '';
            currentText.split('').forEach((ch, i) => {
                const span = document.createElement('span');
                span.className = 'char' + (i === 0 ? ' current' : ' waiting');
                span.textContent = ch;
                display.appendChild(span);
            });
        }

        // ========== 测试控制 ==========
        function startTest() {
            document.getElementById('startOverlay').style.display = 'none';
            document.getElementById('hiddenInput').focus();
            isStarted = true;
            isFinished = false;
            startTimer();
        }

        function startTimer() {
            timeLeft = duration;
            updateTimerDisplay();
            timer = setInterval(() => {
                timeLeft--;
                updateTimerDisplay();
                if (timeLeft <= 0) {
                    finishTest();
                }
            }, 1000);
        }

        function updateTimerDisplay() {
            document.getElementById('timeDisplay').textContent = timeLeft;
            const pct = (timeLeft / duration) * 100;
            document.getElementById('timerFill').style.width = pct + '%';
        }

        function resetTest() {
            clearInterval(timer);
            isStarted = false;
            isFinished = false;
            charIndex = 0;
            errors = 0;
            correctChars = 0;
            totalTyped = 0;
            timeLeft = duration;
            keyHeatMap = {};
            keyErrorMap = {};

            document.getElementById('hiddenInput').value = '';
            document.getElementById('startOverlay').style.display = 'flex';
            document.getElementById('wpmDisplay').textContent = '0';
            document.getElementById('accDisplay').textContent = '100%';
            document.getElementById('timeDisplay').textContent = duration;
            document.getElementById('charDisplay').textContent = '0';
            document.getElementById('timerFill').style.width = '100%';

            renderText();
            resetKeyboard();
        }

        function resetKeyboard() {
            document.querySelectorAll('.key').forEach(k => {
                k.className = k.className.replace(/ hot-\d| error/g, '');
                if (k.id === 'key-SPACE') k.className = 'key space';
                else k.className = 'key';
            });
        }

        function setDuration(d) {
            duration = d;
            document.querySelectorAll('.mode-btn').forEach(btn => btn.classList.remove('active'));
            event.target.classList.add('active');
            resetTest();
        }

        // ========== 输入处理 ==========
        document.addEventListener('DOMContentLoaded', () => {
            const input = document.getElementById('hiddenInput');
            input.addEventListener('input', (e) => {
                if (!isStarted || isFinished) return;

                const chars = document.querySelectorAll('.char');
                const typedChar = e.data;

                if (charIndex < currentText.length && typedChar !== null) {
                    const expected = currentText[charIndex];
                    const keyName = typedChar === ' ' ? 'SPACE' : typedChar.toUpperCase();

                    totalTyped++;
                    keyHeatMap[keyName] = (keyHeatMap[keyName] || 0) + 1;

                    if (typedChar === expected) {
                        chars[charIndex].className = 'char correct';
                        correctChars++;
                    } else {
                        chars[charIndex].className = 'char incorrect';
                        errors++;
                        keyErrorMap[keyName] = (keyErrorMap[keyName] || 0) + 1;
                    }

                    charIndex++;
                    if (charIndex < currentText.length) {
                        chars[charIndex].className = 'char current';
                    }

                    updateStats();
                    updateKeyboardHeatmap();

                    if (charIndex >= currentText.length) {
                        finishTest();
                    }
                }
            });

            // 阻止退格等功能键
            input.addEventListener('keydown', (e) => {
                if (e.key === 'Backspace' || e.key === 'Tab') {
                    e.preventDefault();
                }
            });

            // 点击打字区域聚焦
            document.getElementById('typingArea').addEventListener('click', () => {
                if (isStarted) input.focus();
            });
        });

        function updateStats() {
            const elapsed = duration - timeLeft;
            const minutes = elapsed / 60 || 1/60;
            const wpm = Math.round((correctChars / 5) / minutes);
            const acc = totalTyped > 0 ? Math.round((correctChars / totalTyped) * 100) : 100;

            document.getElementById('wpmDisplay').textContent = wpm;
            document.getElementById('accDisplay').textContent = acc + '%';
            document.getElementById('charDisplay').textContent = totalTyped;
        }

        function updateKeyboardHeatmap() {
            const maxHits = Math.max(...Object.values(keyHeatMap), 1);
            document.querySelectorAll('.key').forEach(k => {
                const name = k.id.replace('key-', '');
                const hits = keyHeatMap[name] || 0;
                const errs = keyErrorMap[name] || 0;
                k.className = k.className.replace(/ hot-\d| error/g, '');
                if (k.id === 'key-SPACE') k.className = 'key space';
                else k.className = 'key';

                if (errs > 2) {
                    k.classList.add('error');
                } else if (hits > 0) {
                    const level = Math.ceil((hits / maxHits) * 3);
                    k.classList.add('hot-' + Math.min(level, 3));
                }
            });
        }

        // ========== 测试结束 ==========
        function finishTest() {
            clearInterval(timer);
            isFinished = true;

            const elapsed = duration - timeLeft || 1;
            const minutes = elapsed / 60;
            const wpm = Math.round((correctChars / 5) / minutes);
            const acc = totalTyped > 0 ? Math.round((correctChars / totalTyped) * 100) : 0;

            let emoji = '🎉', title = '太棒了！';
            if (wpm < 20) { emoji = '💪'; title = '继续加油！'; }
            else if (wpm < 40) { emoji = '👍'; title = '不错的成绩！'; }
            else if (wpm < 60) { emoji = '🔥'; title = '打字高手！'; }
            else { emoji = '🚀'; title = '键盘侠！'; }

            document.getElementById('resultEmoji').textContent = emoji;
            document.getElementById('resultTitle').textContent = title;
            document.getElementById('resultWpm').textContent = wpm;
            document.getElementById('resultAcc').textContent = acc + '%';
            document.getElementById('resultChars').textContent = totalTyped;
            document.getElementById('resultErrors').textContent = errors;
            document.getElementById('resultModal').classList.add('show');

            // 保存历史
            history.unshift({ wpm, acc, chars: totalTyped, errors, duration, date: new Date().toLocaleString() });
            if (history.length > 10) history.pop();
            localStorage.setItem('typingHistory', JSON.stringify(history));
            renderHistory();
        }

        function closeResult() {
            document.getElementById('resultModal').classList.remove('show');
            resetTest();
        }

        // ========== 历史记录 ==========
        function renderHistory() {
            const list = document.getElementById('historyList');
            if (history.length === 0) {
                list.innerHTML = '<div class="empty-state">暂无记录，完成一次测试后显示</div>';
                return;
            }
            list.innerHTML = history.map((h, i) => `
                <div class="history-item">
                    <div class="rank">${i + 1}</div>
                    <div><span class="mode-tag">${h.duration}秒模式</span> <span style="color:#666;font-size:12px;margin-left:8px;">${h.date}</span></div>
                    <div class="wpm">${h.wpm} WPM</div>
                    <div class="acc">${h.acc}%</div>
                    <div class="time">${h.chars}字符</div>
                </div>
            `).join('');
        }

        init();
    </script>
</body>
</html>
